# ── Application ────────────────────────────────────────────────
APP_ENV=development
APP_NAME="Unified Multilingual Grievance Platform"
APP_VERSION=1.0.0
DEBUG=true
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# ── API ────────────────────────────────────────────────────────
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# ── Database ───────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://grievance:grievance@localhost:5432/grievance_db

# ── Redis ──────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ── Object Storage (MinIO / S3-compatible) ───────────────────
STORAGE_ENDPOINT_URL=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET_AUDIO=grievance-audio
STORAGE_BUCKET_DOCS=grievance-docs
STORAGE_USE_SSL=false

# ── JWT Auth ───────────────────────────────────────────────────
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ── AI Services ────────────────────────────────────────────────
# ASR service (IndicConformer microservice or local)
ASR_SERVICE_URL=http://localhost:8001
ASR_SERVICE_TIMEOUT=60
ASR_USE_MOCK=true

# Translation service (IndicTrans2 microservice or local)
TRANSLATION_SERVICE_URL=http://localhost:8002
TRANSLATION_SERVICE_TIMEOUT=60
TRANSLATION_USE_MOCK=true

# LLM service (skipped for Phase 1 — mock only)
LLM_USE_MOCK=true
LLM_SERVICE_URL=http://localhost:8003

# ── Notifications ──────────────────────────────────────────────
# SMS (e.g. Twilio / MSG91)
SMS_PROVIDER=mock
SMS_API_KEY=
SMS_SENDER_ID=GRIEVNC

# WhatsApp (e.g. Twilio / Meta Cloud API)
WHATSAPP_PROVIDER=mock
WHATSAPP_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=

# Email (e.g. SendGrid / SMTP)
EMAIL_PROVIDER=mock
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@grievance.gov.in

# Push Notifications (FCM)
FCM_SERVER_KEY=
FCM_USE_MOCK=true

# ── FFmpeg ─────────────────────────────────────────────────────
FFMPEG_PATH=ffmpeg
AUDIO_TMP_DIR=/tmp/grievance_audio

# ── Phase 3 — Government Registry ─────────────────────────────
REGISTRY_SEED_ON_STARTUP=true
